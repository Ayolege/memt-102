# ─── Wallet ─────────────────────────────────────────────────────────────
# Base58-encoded secret key for the trading wallet (Phantom export format).
# NEVER commit a real key. Use a hot wallet you can afford to lose entirely.
WALLET_SECRET_KEY=

# ─── RPC ────────────────────────────────────────────────────────────────
# Helius / Triton / QuickNode strongly recommended; public RPC will be
# rate-limited and cost you missed fills.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# ─── Safety rails (REQUIRED — bot refuses to start without these) ──────
# Set DRY_RUN=false ONLY when you've verified everything on a tiny size.
DRY_RUN=true
# Hard cap per trade, in USD. Sized in input mint at quote time.
MAX_POSITION_USD=25
# Hard cap on simultaneously open positions.
MAX_OPEN_POSITIONS=3
# If realised + unrealised PnL drops below -DAILY_LOSS_LIMIT_USD, bot halts.
DAILY_LOSS_LIMIT_USD=50
# Touch this file to immediately stop all new entries.
KILL_SWITCH_FILE=./state/KILL

# ─── Quoting / execution ───────────────────────────────────────────────
# Slippage in basis points (100 = 1%). Memecoins often need 300-1500.
SLIPPAGE_BPS=500
# Priority fee in micro-lamports per CU. Bump during congestion.
PRIORITY_FEE_MICROLAMPORTS=200000
# Use the Rust hot-path sender for entries (must run `pnpm build:rust` first).
USE_RUST_SENDER=false
RUST_SENDER_BIN=./rust/target/release/memt-sender

# ─── Strategy: momentum/breakout ───────────────────────────────────────
MOMENTUM_ENABLED=true
# Comma-separated token mints to watch. Default = WIF, BONK, POPCAT.
MOMENTUM_WATCHLIST=EKpQGSJtjMFqKZ9KQanSqYXRcF8fBopzLHYxdM65zcjm,DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263,7GCihgDB8fe6KNjn2MYtkzZcRjQy3t9GHdC8uHYmW2hr
# Poll interval per token (ms).
MOMENTUM_POLL_MS=5000
# Breakout = current price > rolling-window high * (1 + threshold).
MOMENTUM_BREAKOUT_THRESHOLD=0.02
MOMENTUM_LOOKBACK_SAMPLES=24
# Trailing stop & hard stop (fraction of entry).
TRAILING_STOP=0.15
HARD_STOP=0.30
# Take profit (fraction of entry); 0 = disabled.
TAKE_PROFIT=0.50

# ─── Strategy: copy trading ────────────────────────────────────────────
COPY_TRADING_ENABLED=false
# Comma-separated wallet addresses to mirror.
COPY_TARGET_WALLETS=
# Fraction of MAX_POSITION_USD to spend per copied buy (0..1).
COPY_SIZE_FRACTION=1.0
# When the target sells token X, we sell our entire X position.
COPY_MIRROR_SELLS=true

# ─── Base mint (what we hold between trades) ───────────────────────────
# USDC by default; switch to So11111111111111111111111111111111111111112 for SOL.
BASE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
BASE_MINT_DECIMALS=6

# ─── Alerts (optional) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=info
