{
  "name": "memt-102",
  "version": "0.1.0",
  "private": true,
  "description": "Automated Solana memecoin trading bot — momentum + copy trading via Jupiter",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "balance": "tsx src/scripts/balance.ts",
    "pnl": "tsx src/scripts/pnl.ts",
    "backtest": "tsx src/backtest/cli.ts",
    "replay-copy": "tsx src/backtest/copyCli.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
